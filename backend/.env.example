# ─────────────────────────────────────────────────────────────
#  Anthropic API key for the AI Agents + Discovery Scout.
#
#  1. Copy this file to `.env` IN THIS FOLDER:  cp .env.example .env
#  2. Get a key at https://console.anthropic.com (starts with sk-ant-)
#  3. Paste it below — NO quotes, NO spaces around the "="
#  4. Save, then RESTART the server (uvicorn)
#  5. Verify at  http://localhost:8000/api/diag
#
#  `.env` is gitignored and must NEVER be committed. The app reads the
#  key from the environment at runtime; it is not stored in any script.
#  Without a key everything still runs — agents return curated static
#  reports and the Scout returns curated seed candidates.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-key-here

# Optional — only set this if /api/diag reports the default model is
# unavailable to your key. Leave commented out otherwise.
# ANTHROPIC_MODEL=claude-sonnet-4-5
